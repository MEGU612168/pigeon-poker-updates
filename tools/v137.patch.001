+def _playing_card_ink(rank: str, suit: str, four_color: bool = False) -> str:
+    """Keep spades nearly black and clubs vivid green for reliable suit recognition."""
+    suit = str(suit).lower()
+    if suit == "s":
+        return "#151b22"
+    if suit == "c":
+        return "#087b43"
+    return card_face_color(str(rank) + suit, bool(four_color))
+
