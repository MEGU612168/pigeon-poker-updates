+    def _attenuated_wav_for_fallback(self, sound_path: Path, volume: int) -> Path:
+        """Create a cached quiet PCM copy for winsound, which lacks per-play volume."""
+        gain = max(0.0, min(0.32, float(max(0, int(volume))) / 200.0))
+        target = sound_path.with_name(f"{sound_path.stem}_quiet_{int(volume)}.wav")
+        try:
+            if target.is_file() and target.stat().st_mtime >= sound_path.stat().st_mtime:
+                return target
+            with wave.open(str(sound_path), "rb") as source:
+                params = source.getparams()
+                width = source.getsampwidth()
+                raw = source.readframes(source.getnframes())
+            count = len(raw) // max(1, width)
+            if width == 1:
+                attenuated = bytes(max(0, min(255, int(round(128 + (sample - 128) * gain))))
+                                   for sample in raw)
+            elif width in (2, 4):
+                code = "h" if width == 2 else "i"
+                values = struct.unpack("<" + code * count, raw[:count * width])
+                limit = (1 << (width * 8 - 1)) - 1
+                floor = -(1 << (width * 8 - 1))
+                attenuated = struct.pack("<" + code * count,
+                    *(max(floor, min(limit, int(round(sample * gain)))) for sample in values))
+            elif width == 3:
+                samples = []
+                for index in range(0, count * 3, 3):
+                    sample = int.from_bytes(raw[index:index+3], "little", signed=True)
+                    samples.append(int(round(sample * gain)).to_bytes(3, "little", signed=True))
+                attenuated = b"".join(samples)
+            else:
+                return sound_path
+            with wave.open(str(target), "wb") as output:
+                output.setparams(params)
+                output.writeframes(attenuated)
+            return target
+        except (OSError, ValueError, wave.Error, struct.error):
+            return sound_path
+
